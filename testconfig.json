{
  "platformOptions": {
    "resultDirectory": "./test-results"
  },
  "commandLineOptions": {
    "coverage": true,
    "report-xunit-ctrf": true
  },
  "xUnit": {
    "parallelizeTestCollections": false
  },
  "codeCoverage": {
    "Configuration": {
      "Format": "cobertura",
      "CodeCoverage": {
        "SkipAutoProperties": false
      }
    }
  }
}
